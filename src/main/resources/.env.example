# Server
SERVER_PORT=8082

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/together_trip_notification
SPRING_DATASOURCE_USERNAME=together_trip
SPRING_DATASOURCE_PASSWORD=together_trip
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration
JPA_SHOW_SQL=false

# Redis
SPRING_REDIS_HOST=127.0.0.1
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=

# SQS notification consumer
NOTIFICATION_SQS_QUEUE_URL=
NOTIFICATION_QUEUE_URL=
NOTIFICATION_SQS_CONSUMER_ENABLED=true
NOTIFICATION_SQS_FIXED_DELAY=PT3S
NOTIFICATION_SQS_MAX_MESSAGES=10
NOTIFICATION_SQS_WAIT_TIME=10s
NOTIFICATION_SQS_VISIBILITY_TIMEOUT=30s
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# FCM push
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
FCM_CLIENT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_PRIVATE_KEY_ID=
FCM_TOKEN_URI=https://oauth2.googleapis.com/token
FCM_ENDPOINT=https://fcm.googleapis.com
FCM_TIMEOUT=PT3S
